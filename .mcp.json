    "supabase-legacy": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=chaidwvlizbayyugnphw&read_only=true"
    },
    "supabase-dev": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=smqovgawfjmxernqlxjd&features=database,docs,debugging,development,functions,storage"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
