{
  "name": "sarvis",
  "private": true,
  "description": "Sarvis: grocery spending and the ethics of the companies behind it.",
  "type": "module",
  "workspaces": [
    "app",
    "packages/core",
    "pipeline"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "web": "npm run web --workspace @sarvis/app",
    "android": "npm run android --workspace @sarvis/app",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:types": "node scripts/db-types.mjs",
    "dev:test-user": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/dev-create-test-user.ts",
    "dev:recovery-link": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/dev-recovery-link.ts",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dist\" \"**/coverage\" \"**/*.tsbuildinfo\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
