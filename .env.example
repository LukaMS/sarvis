# Copy to .env and fill in. Never commit .env. Values come from the DEV Supabase project only.

# Dev Supabase project URL (Project Settings > API). Bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=

# Dev project's publishable / anon key. Public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dev project's service-role key. Only for dev-only Node scripts (e.g. creating
# confirmed e2e test users, D-015). Never in the app, never in an EXPO_PUBLIC_ var,
# never the legacy project.
SUPABASE_DEV_SERVICE_ROLE_KEY=
